# Base URL of your existing Java Spring Boot backend.
# Local development default:
VITE_API_BASE_URL=http://localhost:1004

# For production (e.g. Vercel), set this to your deployed Spring Boot API URL, e.g.:
# VITE_API_BASE_URL=https://api.intellihire.yourdomain.com
#
# NOTE: Never place secrets (private keys, DB passwords, JWT signing secrets)
# in VITE_* variables — they are embedded into the public client bundle.
